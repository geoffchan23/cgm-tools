<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Watch Face Format: no code, no service. The system finds the face
         via the format.version property and res/raw/watchface.xml. This
         mirrors the official WatchFaceFormat sample manifest. -->
    <application
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/watch_face_name">

        <!-- WFF version 2 == Wear OS 5 and up. The Pixel Watch 2 runs
             Wear OS 6, so this is comfortably supported. -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="2" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
    </application>
</manifest>
